@using FastEndpoints
@using MudBlazor
@using SpotTool.Web.Domain
@using SpotTool.Web.Domain.Helpers
@using SpotTool.Web.Domain.Types
@using SpotTool.Web.Features.Offers.Create
@using SpotTool.Web.Features.Offers.Reject
@using SpotTool.Web.Features.Spots.Accept
@using SpotTool.Web.Features.Spots.Reject

@inject IDateTimeProvider _dateTimeProvider

<style>
    .selected {
        background-color: #1E88E5 !important;
    }

    .selected > td {
        color: white !important;
    }

    .selected > td .mud-input {
        color: white !important;
    }
</style>

<MudDialog>
    <TitleContent>
        @MudDialog?.Title
    </TitleContent>
    <DialogContent>
        <MudTable T="@DbModels.Offer" Items="@Offers" Hover="true" Breakpoint="Breakpoint.Sm" Loading="false" LoadingProgressColor="Color.Info"
            @bind-SelectedItem="_selectedOffer" RowClassFunc="@SelectedRowClassFunc">
                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Bidder</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Currency</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Valid till</MudTh>
                    <MudTh>Bid's feedback</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="Bidder">
                        @(context.Status == Status.Offer.ToNegotiation ? context.CreatedByUser.PersonDetail.Email : context.CreatedForUser.PersonDetail.Email)
                    </MudTd>
                    <MudTd DataLabel="Value">@context.Value</MudTd>    
                    <MudTd DataLabel="Currency">@context.CurrencyCode</MudTd>    
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Valid-till">@GetValidTillInUserTime(context.ValidTill)</MudTd>                   
                    <MudTd DataLabel="Feedback">
                        @{
                            var color = GetOfferColor(@context.ValueStatus);
                        }
                        <MudChip T="@string" Color="@color">@context.ValueStatus.ToString()[0]</MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
    </DialogContent>
    <DialogActions>
        @if(IssuerId.Equals(SpotUserId))
        {
            //Powinno byc sterowane z Serwera jak przyciski na stronie /spot/active
            if(SpotStatus != Status.Spot.Negotiation)
            {
                <MudButton Color="Color.Info" OnClick="(() => AddOfferAsync(_selectedOffer?.SpotId))">Start negotiation</MudButton>
            }
            <MudButton Color="Color.Primary" OnClick="AcceptSpotAsync">Accept offer</MudButton> <br/>
            <MudButton Color="Color.Error" OnClick="RejectSpotAsync">Reject all offers</MudButton>
        }
        else
        {
            if(SpotStatus == Status.Spot.Negotiation)
            {
                <MudButton Color="Color.Info" OnClick="RejectOfferAsync">Reject negotiation</MudButton>
            }
        }
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public List<DbModels.Offer> Offers { get; set; } = [];

    [Parameter]
    public TimeSpan? UserOffset {get; set;}

    [Parameter]
    public Guid IssuerId {get;set;}
    [Parameter]
    public Guid SpotUserId {get; set;}
    [Parameter]
    public Status.Spot SpotStatus {get; set;}

    DbModels.Offer? _selectedOffer { get; set; }
    int _selectedRowNumber = -1;


    protected override void OnInitialized()
    {
        _selectedOffer = Offers.FirstOrDefault(m=>m.IsWinnerOffer == true);
        Console.WriteLine($"Selected is: {_selectedOffer?.Id}");
    }

    private async Task RejectOfferAsync()
    {
        if(_selectedOffer is not null)
        {
            var rejectOfferCommandResult = await new RejectOfferCommand(
                    _selectedOffer.Id, 
                    _selectedOffer.CreatedByUser.Id, 
                    _selectedOffer.CreatedForUser.Id, 
                    "Test - reject by carrier from dialog")
                .ExecuteAsync();
            
            if(rejectOfferCommandResult.IsError)
                Console.WriteLine($"Error reject offer: {rejectOfferCommandResult.ErrorMsg}");
            else
                MudDialog?.Close(DialogResult.Ok(true));
        }
    }
    private async Task AcceptSpotAsync()
    {
        if(_selectedOffer is not null)
        {
            var command = new AcceptSpotCommand(_selectedOffer.SpotId, _selectedOffer.Id);
            var result = await command.ExecuteAsync();

            if(result.IsError)
                Console.WriteLine($"Error accept spot: {result.ErrorMesage}");
            else
                MudDialog?.Close(DialogResult.Ok(true));
        }
    }

    private async Task RejectSpotAsync()
    {
        if(Offers.Count > 0)
        {        
            var command = new RejectSpotCommand(Offers[0].SpotId);
            var result = await command.ExecuteAsync();

            if(result.IsError)
                Console.WriteLine($"Error reject spot: {result.ErrorMsg}");
            else
                MudDialog?.Close(DialogResult.Ok(true));
        } 
    }
    private void Cancel() => MudDialog?.Cancel();

    MudBlazor.Color GetOfferColor(Status.OfferValue offerValue) => offerValue switch
    {
        Status.OfferValue.Green => MudBlazor.Color.Success,
        Status.OfferValue.Yellow => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Error
    };

    string SelectedRowClassFunc(DbModels.Offer element, int rowNumber)
    {
        if (_selectedRowNumber == rowNumber)
        {
            _selectedRowNumber = -1;
            return string.Empty;
        }

        if (_selectedOffer is not null && _selectedOffer.Equals(element))
        {
            _selectedRowNumber = rowNumber;
            Console.WriteLine($"Selected offerID: {element.Id}");
            return "selected";
        }

        return string.Empty;
    }

    string GetValidTillInUserTime(DateTimeOffset validTill)
    {
        return _dateTimeProvider.ToUserLocalTime(validTill, UserOffset ?? TimeSpan.Zero);
    }
    async Task AddOfferAsync(Guid? spotId)
    {
        if(spotId is not null)
        {
            var createOfferResult = await new CreateOfferCommand(
                (Guid)spotId, IssuerId, _selectedOffer!.UserId, Random.Shared.Next(100, 200) * 1.5M, Currency.Code.EUR,
                null, _dateTimeProvider.Now().AddMinutes(2)
            ).ExecuteAsync();

            if(createOfferResult.IsError)
                Console.WriteLine($"Error: addOffer - {createOfferResult.ErrorMsg}");
            else
                MudDialog?.Close(DialogResult.Ok(true));
        }
    }
}