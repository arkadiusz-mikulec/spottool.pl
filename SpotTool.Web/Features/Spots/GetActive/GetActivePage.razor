@page "/spots/active/{UserId:int}"
@using System.Threading.Channels
@using FastEndpoints
@using ImTools
@using Marten
@using Microsoft.JSInterop
@using MudBlazor
@using SpotTool.Web.Contracts
@using SpotTool.Web.Contracts.UI.Spot
@using SpotTool.Web.Domain
@using SpotTool.Web.Domain.Helpers
@using SpotTool.Web.Domain.Types
@using SpotTool.Web.Features.Offers.Create
@using SpotTool.Web.Features.Offers.Reject
@using SpotTool.Web.Features.Shared.Channels
@using SpotTool.Web.Features.Shared.Spots
@using SpotTool.Web.Features.Spots.Approve
@using SpotTool.Web.Features.Spots.Create
@using SpotTool.Web.Features.Spots.UpdateDeadlina
@using SpotTool.Web.Features.Users

@inject SpotService _spotService
@inject SpotChannelManager _spotChannelMenager
@* @inject PersistentComponentState ApplicationState *@
@implements IDisposable
@inject IDocumentSession _session
@inject IJSRuntime _jsRuntime
@inject IDateTimeProvider _dateTimeProvider
@inject UserService _userService
@inject NavigationManager _navi
@inject IConfiguration _appConfig
@inject IDialogService DialogService


<MudSelect @bind-Value="@currentUserId">
    <MudSelectItem Value="1">@("arkadiusz.mikulec@gmail.com")</MudSelectItem>
    <MudSelectItem Value="2">@("amikulec@sostmeier.pl")</MudSelectItem>
    <MudSelectItem Value="3">@("biuro@e-site.pl")</MudSelectItem>
</MudSelect>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateUser">Update</MudButton> 

<p>@userDataProvider?.Email with offset @userDataProvider?.userOffset.ToString()</p>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSpotAsync" Disabled="@createSpotBtnDisabled">Create spot</MudButton> 

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">
            <MudTable Items="@Spots" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@loading" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Contact</MudTh>
                    <MudTh>Deadline</MudTh>
                    <MudTh>Current Status</MudTh>
                    <MudTh>Route</MudTh>
                    <MudTh>Contact phone</MudTh>
                    <MudTh>Operations</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Id">
                        @{
                            string link = $"/spots/{context.SpotModel.Spot.Id}";
                            string pseudoNumber = $"Spot-{Random.Shared.Next(1000, 9999)}";
                        }
                        <MudLink Href="@link">@context.SpotModel.Spot.UserId</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Contact person">@(context.SpotModel.Spot.ContactDetails?.Email ?? context.SpotModel.Spot.CreatedByUser.PersonDetail.Email)</MudTd>
                    <MudTd DataLabel="Deadline">@_dateTimeProvider.ToUserLocalTime(context.SpotModel.Spot.DeadLine, userDataProvider!.userOffset)</MudTd>
                    <MudTd DataLabel="Current Status">
                        @{
                            (MudBlazor.Color color, string text, string style) = context.StatusUIRespond.GetStatusProperties();
                        }
                        <MudChip T="@string" Color="@color" Style="@style"
                            OnClick="((e) => OpenOfferHistoryDialogAsync(context.SpotModel.Spot.Id))" Disabled="false">
                                @text
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Route">
                        <MudText>
                            @((MarkupString)context.SpotModel.Spot.Description!)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Contact phone" HideSmall="true">@(context.SpotModel.Spot.ContactDetails?.Mobile ?? @context.SpotModel.Spot.CreatedByUser.PersonDetail.Mobile)</MudTd>
                    <MudTd DataLabel="Operations">
                        @foreach(var button in context.SpotButtons)
                        {                
                            <_buttonIconComponent Button="@button" OnClickEvent="(() => OnButtonClick(button.ActionName, context.SpotModel.Spot.Id))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public int UserId {get; set;} = 1;
    List<SpotUIRespond> Spots { get; set; } = [];
    private CancellationTokenSource cts = new CancellationTokenSource();
    int currentUserId = 1;
    record UserProvider(Guid Id, string Email, List<Guid> userGroups, TimeSpan userOffset, List<Role.User> Roles, Status.User Status);
    UserProvider? userDataProvider = null;
    bool loading {  get; set; } = true;
    bool createSpotBtnDisabled = true;
    protected override async Task OnInitializedAsync()
    {

        (string, TimeSpan) currentUser = 
            (UserId == 1 ? 
                ("arkadiusz.mikulec@gmail.com", TimeSpan.FromMinutes(120)) : 
            UserId == 2 ? 
                ("amikulec@sostmeier.pl", TimeSpan.FromMinutes(60)) : ("biuro@e-site.pl", TimeSpan.Zero));

        //To bedzie kol na stronie logowanie
        var user = await _userService.GetUserByEmailAsync(currentUser.Item1, cts.Token);

        userDataProvider = new UserProvider(
            user!.Id, user.ContactDetails.Email, [],  currentUser.Item2, user.Roles, user.Status);

        Console.WriteLine($"Current user: {userDataProvider.Email}");

        if(userDataProvider.Roles.Contains(Role.User.Issuer))
            createSpotBtnDisabled = false;
        else
            createSpotBtnDisabled = true;

        var reader = _spotChannelMenager.Subscribe(userDataProvider.Id, userDataProvider.Roles, userDataProvider.userGroups);

        Spots = await _spotService.InitActiveSpotsAsync(
            userDataProvider.Id,
            userDataProvider.userOffset,
            cts.Token
        );

        _ = ConsumeSpotChannelsAsync(reader);
        loading = false;
    }

