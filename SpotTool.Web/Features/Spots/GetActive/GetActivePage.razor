            }
        } 
        
        //return base.OnAfterRenderAsync(firstRender);
    }*@

    
    private Task OpenOfferHistoryDialogAsync(Guid spotId)
    {
        var spot = Spots.FirstOrDefault(m=>m.SpotModel.Spot.Id == spotId);

        if(spot is null)
            return Task.CompletedTask;

        List<DbModels.Offer> spotOffers = []; 

        // Issuer. Ale mozemy miec ta dane rowniez w SpotUiRespond
        var isIssuer = _userService.IsSpotCreator(userDataProvider!.Id, spot.SpotModel.Spot.UserId);
        if(isIssuer)
            spotOffers = spot.SpotModel.Offers;
        else
            spotOffers = [.. spot.SpotModel.Offers.Where(m=>m.UserId == userDataProvider!.Id)];

        if(spotOffers.Count > 1 || (isIssuer && spotOffers.Count > 0))
        {
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
            var parameters = new DialogParameters<OffersHistoryDialog>();

            parameters.Add(x => x.Offers, [.. spotOffers.OrderBy(m=>m.Value)]);
            parameters.Add(x => x.UserOffset, userDataProvider?.userOffset);
            parameters.Add(x=>x.IssuerId, userDataProvider!.Id);
            parameters.Add(x=>x.SpotUserId, spot.SpotModel.Spot.UserId);
            parameters.Add(x=>x.SpotStatus, spot.SpotModel.Spot.CurrentStatus);

            //alternatywa
            @* var parameters = new DialogParameters<Dialog>
            {
                { nameof(Dialog.Offers), [.. spotOffers.OrderBy(m => m.Value)] },
                { nameof(Dialog.UserOffset), userDataProvider?.userOffset }
            }; *@

            return DialogService.ShowAsync<OffersHistoryDialog>($"Offer's history for SpotID: {spotId}", parameters, options);    
        }
        return Task.CompletedTask;
    }

    private Task OpenAddOfferDialogAsync(Guid spotId)
    {
        var spot = Spots.FirstOrDefault(m=>m.SpotModel.Spot.Id == spotId);

        if(spot is null)
            return Task.CompletedTask;

        DbModels.Offer? lastOffer = null;      
    
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        var parameters = new DialogParameters<AddOfferDialog>();

        parameters.Add(x => x.UserOffset, userDataProvider?.userOffset);
        parameters.Add(x=>x.UserId, userDataProvider!.Id);
        parameters.Add(x=>x.LastOffer, lastOffer);
        parameters.Add(x=>x.SpotId, spotId);

        return DialogService.ShowAsync<AddOfferDialog>($"Add offer for SpotID: {spotId}", parameters, options);
    }

    async Task OnButtonClick(ButtonAction buttonAction, Guid spotId)
    {
        switch(buttonAction)
        {
            case ButtonAction.ADD_OFFER: await OpenAddOfferDialogAsync(spotId);
                break;
            case ButtonAction.CONFIRM_SPOT: await ConfirmSpotAsync(spotId);
                break;
            case ButtonAction.EDIT_SPOT: await UpdateDeadlinaAsync(spotId);
                break;
            case ButtonAction.REJECT_OFFER: await RejectOfferAsync(spotId);
                break;
            default: Console.WriteLine($"button: {buttonAction} was clicked");
                break;
        }
    }

    private async Task RejectOfferAsync(Guid spotId)
    {
        var offerToReject = await _session.Query<DbModels.Offer>()
                .FirstOrDefaultAsync(m=>m.SpotId == spotId && m.Status == Status.Offer.ToNegotiation, cts.Token);

        if(offerToReject is null)
        {
            Console.WriteLine($"Error offer rejection");
            return;
        }

        var rejectOfferCommandResult = await new RejectOfferCommand(
                offerToReject.Id, 
                offerToReject.CreatedByUser.Id, 
                offerToReject.CreatedForUser.Id, 
                "Test - Carrier reject neg from active page")
            .ExecuteAsync();

        if(rejectOfferCommandResult.IsError)
            Console.WriteLine($"Error offer rejection: {rejectOfferCommandResult.ErrorMsg}");

    }
    async Task ConfirmSpotAsync(Guid spotId)
    {
        var confirmSpotComandResult = await new ApproveSpotRequest(spotId)
            .ExecuteAsync(cts.Token);

        if(confirmSpotComandResult.IsError)
            Console.WriteLine(confirmSpotComandResult.ErrorMsg);

    }
    @* async Task AddOfferAsync(Guid spotId)
    {
        var createOfferResult = await new CreateOfferCommand(
            spotId, userDataProvider!.Id, userDataProvider.Id, Random.Shared.Next(200, 500) * 1.5M, Currency.Code.EUR,
            "Loading tomorrow", null
        ).ExecuteAsync(cts.Token);

        if(createOfferResult.IsError)
            Console.WriteLine($"Error: addOfer - {createOfferResult.ErrorMsg}");
    } *@

    async Task UpdateDeadlinaAsync(Guid spotId)
    {
        var updateSpotDeadlineResult = await new UpdateDeadlineCommand(
            spotId, 
            _dateTimeProvider.Now().AddMinutes(2))
        .ExecuteAsync(cts.Token);

        if(updateSpotDeadlineResult.IsError)
            Console.WriteLine($"Error: update deadlina - {updateSpotDeadlineResult.ErrorMsg}");
    }
    async Task CreateSpotAsync()
    {
        int startCode = Random.Shared.Next(10, 99);
        int stopCode = Random.Shared.Next(10, 99);
        string[] countries = ["DE", "PL", "CZ", "SK", "ES", "PT", "NL", "AT"];
        string startCountry = $"{countries[Random.Shared.Next(0, 7)]}{startCode}";
        string stopCountry = $"{countries[Random.Shared.Next(0, 7)]}{stopCode}";
        int index = Random.Shared.Next(1, 66); 
        DateTimeOffset loadingDatetime = _dateTimeProvider.Now().AddHours(index);
        string route = $"<b>{startCountry}</b> ({loadingDatetime.ToString("g")}) -> <b>{stopCountry}</b> ({loadingDatetime.AddDays(1).ToString("g")})" + 
            $"<br/>{index} plt (120*80*80) {index*250}kg<br/>Stack factor: <b>1+1</b>";

        bool setTestData = false;
        Status.Spot status = Status.Spot.NotConfirmed;

        if(!string.IsNullOrEmpty(_appConfig["TestData:ContactPerson:Name"]))
            setTestData = true;

        if(!string.IsNullOrEmpty(_appConfig["TestData:Route"]))
        {
            route = _appConfig["TestData:Route"]!;
            status = Status.Spot.Ok;
        }

        var creatSpotCommand = new CreateSpotCommand(
            userDataProvider!.Id,
            route,
            (index * 150),
            null, 
            status, 
            setTestData ? 
                new DbModels.ContactPersonDetail(
                    _appConfig["TestData:ContactPerson:Name"]!,
                    _appConfig["TestData:ContactPerson:Mobile"]!,
                    _appConfig["TestData:ContactPerson:Email"]!) : 
                null
        );

        var createResult = await creatSpotCommand.ExecuteAsync(cts.Token);
    }
    Task UpdateUser()
    {
        _navi.NavigateTo($"/spots/active/{currentUserId}", true);
        return Task.CompletedTask;
    }
    async Task ConsumeSpotChannelsAsync(ChannelReader<SpotSignal> reader)
    {
        try
        {
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var signal in reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    switch(signal.Type)
                    {
                        //OK !!!
                        case SignalType.SpotCreate:
                            if (signal.SpotUiRespond != null)
                            { 
                                Console.WriteLine("Add/edit spot");
                                var spot = Spots.FirstOrDefault(s => s.SpotModel.Spot.Id == signal.SpotUiRespond.SpotModel.Spot.Id);
                                if (spot is null)
                                    Spots.Add(signal.SpotUiRespond);
                            }
                            break;
                        //Ok!!
                        case SignalType.SpotApprove:
                            if (signal.SpotUiRespond is not null)
                            {
                                var spot = Spots.FirstOrDefault(s => s.SpotModel.Spot.Id == signal.SpotUiRespond.SpotModel.Spot.Id);
                                if (spot is not null)
                                {
                                    //nie odswierza UI bo zmieniam lokalna zmienna
                                    //musiałbym zrobic Spots[index] = signal.SpotUiRespond
                                    //spot = signal.SpotUiRespond;  

                                    //działą poprawnie bo obiekt pozstaje ten sam ale zmieniam bebechy i Blazor widzi zmiane
                                    // mozna tez zrobic lokalna funkcje ktora bedie podmieniac bebechy
                                    //public void UpdateFrom(SpotUIRespond signal.SpotUiRespond)
                                    @* {
                                        if (signal.SpotUiRespond == null) return;
                                        this.SpotModel = signal.SpotUiRespond.SpotModel;
                                        this.StatusUIRespond = signal.SpotUiRespond.StatusUIRespond;
                                        this.SpotButtons = signal.SpotUiRespond.SpotButtons;
                                    } *@
                                    spot.StatusUIRespond = signal.SpotUiRespond.StatusUIRespond;
                                    spot.SpotButtons = signal.SpotUiRespond.SpotButtons;
                                    spot.SpotModel = signal.SpotUiRespond.SpotModel;
                                }
                                else
                                    Spots.Add(signal.SpotUiRespond);
                            }
                            break;
                        //OK!!
                        case SignalType.SpotDeadLineUpdate:
                            if (signal.SpotDeadlineUpdateRespond is not null)
                            {
                                Console.WriteLine("spot deadline update signal");
                                var spot = Spots.FirstOrDefault(s => s.SpotModel.Spot.Id == signal.SpotDeadlineUpdateRespond.SpotId);
                                if (spot is not null)
                                    spot.SpotModel.Spot.DeadLine = signal.SpotDeadlineUpdateRespond.DeadLine;
                            }
                            break;
                        // Usuneło z listy ale negocjacja sie posypała
                        case SignalType.SpotStatusUpdate:
                            if (signal.SpotUiRespond is not null)
                            {
                                Console.WriteLine("Update spot status");
                                var spot = Spots.FirstOrDefault(s => s.SpotModel.Spot.Id == signal.SpotUiRespond.SpotModel.Spot.Id);
                                if (spot is not null)
                                {
                                    var currentStatus = signal.SpotUiRespond.SpotModel.Spot.CurrentStatus;
                                    var userPlacedTheBid = signal.SpotUiRespond.SpotModel.Spot.BiddersId?.Any(m=>m == userDataProvider?.Id);

                                    Console.WriteLine($"Current status: {currentStatus}, userPlacedTheBid: {userPlacedTheBid}");
                                    if(currentStatus == Status.Spot.Deleted ||
                                        ((userPlacedTheBid is null || userPlacedTheBid == false) &&
                                        !_userService.IsSpotCreator(userDataProvider!.Id, signal.SpotUiRespond.SpotModel.Spot.UserId))
                                    )
                                        Spots.Remove(spot);
                                    else
                                    {
                                        spot.StatusUIRespond = signal.SpotUiRespond.StatusUIRespond;
                                        spot.SpotButtons = signal.SpotUiRespond.SpotButtons;
                                        spot.SpotModel = signal.SpotUiRespond.SpotModel;
                                    }
                                }
                            }
                            break;
                        //OfferCreate jest jak status update #thinkAboutIt
                        case SignalType.OfferCreate:
                            if (signal.SpotUiRespond is not null)
                            {
                                Console.WriteLine("offer Create signal");
                                var spot = Spots.FirstOrDefault(s => 
                                    s.SpotModel.Spot.Id == signal.SpotUiRespond.SpotModel.Spot.Id);
                                if (spot is not null)
                                {
                                    spot.StatusUIRespond = signal.SpotUiRespond.StatusUIRespond;
                                    spot.SpotButtons = signal.SpotUiRespond.SpotButtons;
                                    spot.SpotModel = signal.SpotUiRespond.SpotModel;
                                }
                            }
                            break;
                        @* case SignalType.OfferReject:
                            if (signal.SpotUiRespond is not null)
                            {
                                Console.WriteLine("offer reject signal");
                                var spot = Spots.FirstOrDefault(s => s.SpotModel.Spot.Id == signal.SpotUiRespond.SpotModel.Spot.Id);
                                if (spot is not null)
                                {
                                    spot.StatusUIRespond = signal.SpotUiRespond.StatusUIRespond;
                                    spot.SpotButtons = signal.SpotUiRespond.SpotButtons;
                                    spot.SpotModel = signal.SpotUiRespond.SpotModel;
                                } 
                            }
                            break; *@
                    }
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
        catch (Exception)
        {
            // KLUCZOWE: Zapisujemy błąd w logach aplikacji (np. Serilog, NLog, Console)
            //Logger.LogError(ex, "Wystąpił krytyczny błąd w tle podczas czytania z Channel.");
            
            // Opcjonalnie: Możesz ustawić flagę błędu w UI, aby powiadomić użytkownika
            //HasError = true;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    

