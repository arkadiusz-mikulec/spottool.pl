    public void Dispose()
    {
        // Odpinamy subskrypcję stanu, aby zapobiec wyciekom pamięci
        //_subscription.Dispose();

        if (cts is { IsCancellationRequested: false })
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException) { /* Ignoruj */ }
        }
        cts?.Dispose();
        // 3. Sprzątamy połączenie w singletonie przy opuszczeniu strony
        _spotChannelMenager.Unsubscribe(userDataProvider!.Id);
    }
}
