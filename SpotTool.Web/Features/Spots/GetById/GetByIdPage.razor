@page "/spots/{Id:guid?}"
@using System.Threading.Channels
@using SpotTool.Web.Domain
@using SpotTool.Web.Features.Shared.Spots

@inject SpotService _spotService
@inject Channel<DbModels.Spot> _channel
@* @inject PersistentComponentState ApplicationState *@
@implements IDisposable


@if (Spots.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th aria-label="Temperature in Celsius">Temp. (C)</th>
                <th aria-label="Temperature in Fahrenheit">Temp. (F)</th>
                <th>Summary</th>

                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spot in Spots)
            {
                <tr>
                    <td>@spot.Id</td>
                    <td>@spot.DeadLine.ToString("g")</td>
                    <td>@spot.CurrencyCode</td>
                    <td>@spot.CurrentStatus</td>
                    <td>@spot.CreatedByUser.Role</td>
                    <td>@spot.CreatedByUser.Status</td>
                    <td>@(spot.ContactDetails?.Email ?? spot.CreatedByUser.PersonDetail.Email)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public Guid? Id {get; set;} = null;
    List<DbModels.Spot> Spots { get; set; } = [];

    private CancellationTokenSource cts = new CancellationTokenSource();
    //private PersistingComponentStateSubscription _subscription;

    @* protected override async Task OnInitializedAsync()
    {
        // 1. Rejestrujemy akcję, która wykona się TUŻ PRZED wysłaniem prerenderowanego HTML do przeglądarki
        _subscription = ApplicationState.RegisterOnPersisting(PersistSpots);

        // 2. Próbujemy odzyskać dane ze stanu (jeśli to drugie uruchomienie po SignalR)
        if (ApplicationState.TryTakeFromJson<IReadOnlyList<DbModels.Spot>>("spots_data", out var restoredSpots))
        {
            // Dane istniały w pamięci podręcznej – przypisujemy je i NIE odpytujemy bazy!
            Spots = restoredSpots ?? [];
            Console.WriteLine($"Spots gets from cash: {Spots.Count}");
        }
        else
        {
            // Dane nie istniały (to jest PIERWSZE uruchomienie / Prerender) – odpytujemy bazę
            if(Id is null)
                Spots = await _spotService.GetSpotsAsync(cts.Token);
            else
            {
                var spot = await _spotService.GetSpotByIdAsync((Guid)Id!, cts.Token);
                if(spot is not null)
                    Spots = [spot];
            }
            Console.WriteLine($"Spots get from DB: {Spots.Count}");
        }
    } *@

    protected override async Task OnInitializedAsync()
    {
        // Dane nie istniały (to jest PIERWSZE uruchomienie / Prerender) – odpytujemy bazę
        if(Id is null)
            Spots = await _spotService.GetSpotsAsync(cts.Token);
        else
        {
            var spot = await _spotService.GetSpotByIdAsync((Guid)Id!, cts.Token);
            if(spot is not null)
                Spots = [spot];
        }
        Console.WriteLine($"Spots.Count: {Spots.Count}");
        _ = ConsumeChannelAsync();
    
    }
    // Ta metoda uruchamia się automatycznie pod koniec Prerenderu
    @* private Task PersistSpots()
    {
        // Pakujemy pobraną listę do specjalnego, ukrytego kontenera w HTML
        ApplicationState.PersistAsJson("spots_data", Spots);
        return Task.CompletedTask;
    } *@

    async Task ConsumeChannelAsync()
    {
        try
        {
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var message in _channel.Reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    Spots.Add(message);
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
    }

    public void Dispose()
    {
        // Odpinamy subskrypcję stanu, aby zapobiec wyciekom pamięci
        //_subscription.Dispose();

        if (cts is { IsCancellationRequested: false })
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException) { /* Ignoruj */ }
        }
        cts?.Dispose();
    }
}
