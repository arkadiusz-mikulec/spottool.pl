    async Task ConsumeSpotChannelsAsync(ChannelReader<SpotChannelManager.SpotSignal> reader)
    {
        try
        {
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var signal in reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    switch(signal.Type)
                    {
                        case SpotChannelManager.SignalType.SpotAdded:
                            if (signal.Spot != null)
                            { 
                                var spot = Spots.FirstOrDefault(s => s.Id == signal.Spot.Id);
                                if (spot is null)
                                    Spots.Add(signal.Spot);
                                else
                                {
                                    spot.CurrentStatus = signal.Spot.CurrentStatus; 
                                    spot.DeadLine = signal.Spot.DeadLine;
                                } 
                            }
                            break;

                        case SpotChannelManager.SignalType.SpotStatusUpdate:
                            if (signal.StatusUpdate != null)
                            {
                                var spot = Spots.FirstOrDefault(s => s.Id == signal.StatusUpdate.SpotId);
                                if (spot != null) 
                                    spot.CurrentStatus = signal.StatusUpdate.Status; // Aktualizacja statusu w tabeli
                            }
                            break;
                    }
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
            
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
        catch (Exception)
        {
            // KLUCZOWE: Zapisujemy błąd w logach aplikacji (np. Serilog, NLog, Console)
            //Logger.LogError(ex, "Wystąpił krytyczny błąd w tle podczas czytania z Channel.");
            
            // Opcjonalnie: Możesz ustawić flagę błędu w UI, aby powiadomić użytkownika
            //HasError = true;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    

