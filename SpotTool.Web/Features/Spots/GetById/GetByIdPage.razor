@page "/spots/{Id:guid?}"
@using System.Threading.Channels
@using Marten
@using MudBlazor
@using SpotTool.Web.Contracts.Spot
@using SpotTool.Web.Domain
@using SpotTool.Web.Features.Shared.Spots

@inject SpotService _spotService
@inject Channel<DbModels.Spot> _channel
@inject Channel<DbModels.Offer> _offerChannel
@inject Channel<SpotStatusUpdateRequest> _spotStatusChannel
@* @inject PersistentComponentState ApplicationState *@
@implements IDisposable
@inject IDocumentSession session

@if (Spots.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    
    <table class="table">
        <thead>
            <th>SpotID</th>
            <th>OfferID</th>
            <th>Value</th>
            <th>Status</th>
            <th>ValueStatus</th>
        </thead>
        <tbody>
            @foreach (var spot in Spots)
            {
                @foreach (var offer in Offers.Where(m=>m.SpotId == spot.Id))
                {
                    <tr>
                        <td>@offer.SpotId</td>
                        <td>@offer.Id</td>
                        <td>@offer.Value</td>
                        <td>@offer.Status</td>
                        <td>@offer.ValueStatus</td>
                    </tr>
                }
            }
            </tbody>
    </table>
}

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th aria-label="Temperature in Celsius">Temp. (C)</th>
                        <th aria-label="Temperature in Fahrenheit">Temp. (F)</th>
                        <th>Summary</th>

                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var spot in Spots)
                    {
                        <tr>
                            <td>@spot.Id</td>
                            <td>@spot.DeadLine.ToString("g")</td>
                            <td>@spot.CurrencyCode</td>
                            <td>@spot.CurrentStatus</td>
                            <td>@spot.CreatedByUser.Role</td>
                            <td>@spot.CreatedByUser.Status</td>
                            <td>@(spot.ContactDetails?.Email ?? spot.CreatedByUser.PersonDetail.Email)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">xs=6</MudPaper>
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">xs=6 fsdfs sdfsd f<br/></MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">xs=3</MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">xs=3</MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">xs=3</MudPaper>
    </MudItem>
    <MudItem xs="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">xs=3</MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public Guid? Id {get; set;} = null;
    List<DbModels.Spot> Spots { get; set; } = [];
    List<DbModels.Offer> Offers {get; set;} = [];

    private CancellationTokenSource cts = new CancellationTokenSource();
    //private PersistingComponentStateSubscription _subscription;

    @* protected override async Task OnInitializedAsync()
    {
        // 1. Rejestrujemy akcję, która wykona się TUŻ PRZED wysłaniem prerenderowanego HTML do przeglądarki
        _subscription = ApplicationState.RegisterOnPersisting(PersistSpots);

        // 2. Próbujemy odzyskać dane ze stanu (jeśli to drugie uruchomienie po SignalR)
        if (ApplicationState.TryTakeFromJson<IReadOnlyList<DbModels.Spot>>("spots_data", out var restoredSpots))
        {
            // Dane istniały w pamięci podręcznej – przypisujemy je i NIE odpytujemy bazy!
            Spots = restoredSpots ?? [];
            Console.WriteLine($"Spots gets from cash: {Spots.Count}");
        }
        else
        {
            // Dane nie istniały (to jest PIERWSZE uruchomienie / Prerender) – odpytujemy bazę
            if(Id is null)
                Spots = await _spotService.GetSpotsAsync(cts.Token);
            else
            {
                var spot = await _spotService.GetSpotByIdAsync((Guid)Id!, cts.Token);
                if(spot is not null)
                    Spots = [spot];
            }
            Console.WriteLine($"Spots get from DB: {Spots.Count}");
        }
    } *@

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("Init!");
        // Dane nie istniały (to jest PIERWSZE uruchomienie / Prerender) – odpytujemy bazę
        if(Id is null)
        {
            Spots = await _spotService.GetSpotsAsync(cts.Token);
            Offers = await session.Query<DbModels.Offer>().ToAsyncEnumerable(cts.Token).ToListAsync(cts.Token);
        }
        else
        {
            var spot = await _spotService.GetSpotByIdAsync((Guid)Id!, cts.Token);
            if(spot is not null)
            {
                Spots = [spot];
                Offers = await session.Query<DbModels.Offer>().Where(m=>m.SpotId == Id).ToAsyncEnumerable(cts.Token).ToListAsync(cts.Token);               
            }
        }
        Console.WriteLine($"Spots.Count: {Spots.Count}");
        _ = ConsumeChannelAsync();
        _ = ConsumeSpotStatusChannelAsync();
    
    }
    // Ta metoda uruchamia się automatycznie pod koniec Prerenderu
    @* private Task PersistSpots()
    {
        // Pakujemy pobraną listę do specjalnego, ukrytego kontenera w HTML
        ApplicationState.PersistAsJson("spots_data", Spots);
        return Task.CompletedTask;
    } *@

    async Task ConsumeChannelAsync()
    {
        try
        {
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var message in _channel.Reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    Console.WriteLine("Spot consuming");
                    Spots.Add(message);
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
            
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
        catch (Exception)
        {
            // KLUCZOWE: Zapisujemy błąd w logach aplikacji (np. Serilog, NLog, Console)
            //Logger.LogError(ex, "Wystąpił krytyczny błąd w tle podczas czytania z Channel.");
            
            // Opcjonalnie: Możesz ustawić flagę błędu w UI, aby powiadomić użytkownika
            //HasError = true;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    async Task ConsumeSpotStatusChannelAsync()
    {
        try
        {
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var message in _spotStatusChannel.Reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    int index = Spots.FindIndex(m=>m.Id == message.SpotId);
                    if(index == -1)
                        return;

                    Spots[index].CurrentStatus = message.Status;
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
            
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
        catch (Exception)
        {
            // KLUCZOWE: Zapisujemy błąd w logach aplikacji (np. Serilog, NLog, Console)
            //Logger.LogError(ex, "Wystąpił krytyczny błąd w tle podczas czytania z Channel.");
            
            // Opcjonalnie: Możesz ustawić flagę błędu w UI, aby powiadomić użytkownika
            //HasError = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task ConsumeOfferChannelAsync()
    {
        try
        {
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var message in _offerChannel.Reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    Console.WriteLine("Offer consuming");
                    Offers.Add(message);
                    int spotIndex = Spots.FindIndex(m=>m.Id == message.SpotId);
                    Spots[spotIndex].CurrentStatus = Domain.Types.Status.Spot.EndedCostTooHigh;
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
            
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
    }

    public void Dispose()
    {
        // Odpinamy subskrypcję stanu, aby zapobiec wyciekom pamięci
        //_subscription.Dispose();

        if (cts is { IsCancellationRequested: false })
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException) { /* Ignoruj */ }
        }
        cts?.Dispose();
    }
}
