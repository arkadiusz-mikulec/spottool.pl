    private Task OpenDialogAsync(Guid spotId)
    {
        var spot = Spots.FirstOrDefault(m=>m.SpotModel.Spot.Id == spotId);

        if(spot is null)
            return Task.CompletedTask;

        List<DbModels.Offer>? spotOffers = null; 
            
        // Issuer. Ale mozemy miec ta dane rowniez w SpotUiRespond
        if(userDataProvider?.Id == spot.SpotModel.Spot.UserId)
            spotOffers = spot.SpotModel.Offers;
        else
            spotOffers = spot.SpotModel.Offers?.Where(m=>m.UserId == userDataProvider!.Id).ToList();

        if(spotOffers is not null && spotOffers.Count > 0)
        {
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
            var parameters = new DialogParameters<Dialog> { { x => x.Offers, [.. spotOffers.OrderBy(m=>m.Value)] } };
            return DialogService.ShowAsync<Dialog>($"Offer's history for SpotID: {spotId}", parameters, options);    
        }
        return Task.CompletedTask;
    }
    async Task UpdateUser()
    {
        _navi.NavigateTo($"/spots/{currentUserId}", true);
    }
    protected override async Task OnInitializedAsync()
    {
        (string, TimeSpan) currentUser = 
            (UserId == 1 ? 
                ("arkadiusz.mikulec@gmail.com", TimeSpan.FromMinutes(120)) : 
            UserId == 2 ? 
                ("amikulec@sostmeier.pl", TimeSpan.FromMinutes(60)) : ("biuro@e-site.pl", TimeSpan.Zero));

        //To bedzie kol na stronie logowanie
        var user = await _userService.GetUserByEmailAsync(currentUser.Item1, cts.Token);

        userDataProvider = new UserProvider(
            user!.Id, user.ContactDetails.Email, [],  currentUser.Item2, user.Roles, user.Status);

        Console.WriteLine($"Current user: {userDataProvider.Email}");
        

        var reader = _spotChannelMenager.Subscribe(userDataProvider.Id, userDataProvider.Roles, userDataProvider.userGroups);

        DateTimeOffset start = new DateTimeOffset(
            DateOnly.FromDateTime(
                DateTime.Today.AddDays(
                    Convert.ToInt32(_appConfig["UiSettings:DeafultSpotRangeStart"]))
            ), 
            TimeOnly.FromTimeSpan(TimeSpan.Zero), 
            TimeSpan.Zero
        );

        DateTimeOffset end = new DateTimeOffset(
            DateOnly.FromDateTime(
                DateTime.Today.AddDays(
                    Convert.ToInt32(_appConfig["UiSettings:DeafultSpotRangeEnd"]))
            ), 
            TimeOnly.FromTimeSpan(new TimeSpan(23, 59, 59)), 
            TimeSpan.Zero);

        Console.WriteLine($"Initialize spots for range from: {start} to: {end}");

        await _spotService.InitSpotsAsync(
            userDataProvider.Id, 
            userDataProvider.Roles, 
            start, 
            end, 
            cts.Token
        );

        _ = ConsumeSpotChannelsAsync(reader);
        loading = false;
    }

