    async Task ConsumeSpotChannelsAsync(ChannelReader<SpotSignal> reader)
    {
        try
        {
            Console.WriteLine("Consuming..");
            // Czytamy dane asynchronicznie tak długo, jak channel jest otwarty
            // i nie wywołano anulowania (np. poprzez zamknięcie strony)
            await foreach (var signal in reader.ReadAllAsync(cts.Token))
            {
                // Zmiana stanu musi nastąpić w bezpiecznym wątku powiązanym z obwodem Blazora
                await InvokeAsync(() =>
                {
                    switch(signal.Type)
                    {
                        case SignalType.SpotAdded:
                            if (signal.Spot != null)
                            { 
                                Console.WriteLine("Add/edit spot");
                                var spot = Spots.FirstOrDefault(s => s.Spot.Id == signal.Spot.Spot.Id);
                                if (spot is null)
                                    Spots.Add(signal.Spot);
                                else
                                {
                                    //tmp solution for approve and Update spot deadline
                                    spot.Spot.CurrentStatus = signal.Spot.Spot.CurrentStatus;
                                    spot.StatusDescription = signal.Spot.StatusDescription;
                                    spot.Spot.DeadLine = signal.Spot.Spot.DeadLine;
                                } 
                            }
                            break;

                        case SignalType.SpotStatusUpdate:
                            if (signal.StatusUpdate != null)
                            {
                                Console.WriteLine("Update spot status");
                                var spot = Spots.FirstOrDefault(s => s.Spot.Id == signal.StatusUpdate.SpotId);
                                if (spot != null) 
                                    spot.Spot.CurrentStatus = signal.StatusUpdate.Status; // Aktualizacja statusu w tabeli
                            }
                            break;
                    }
                    StateHasChanged(); // Wymuszenie ponownego renderowania UI
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normalne zachowanie przy opuszczeniu strony
        }
        catch (Exception)
        {
            // KLUCZOWE: Zapisujemy błąd w logach aplikacji (np. Serilog, NLog, Console)
            //Logger.LogError(ex, "Wystąpił krytyczny błąd w tle podczas czytania z Channel.");
            
            // Opcjonalnie: Możesz ustawić flagę błędu w UI, aby powiadomić użytkownika
            //HasError = true;
            await InvokeAsync(StateHasChanged);
        }
    }
    
    

