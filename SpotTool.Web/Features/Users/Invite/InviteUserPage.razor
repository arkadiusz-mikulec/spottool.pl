@page "/users/invite"
@using FastEndpoints
@using Marten
@using MudBlazor
@using SpotTool.Web.Domain.Helpers
@using SpotTool.Web.Domain.Types
@using SpotTool.Web.Features.Shared.Cookies
@using SpotTool.Web.Features.Users

@implements IDisposable
@inject UserService _userService
@inject NavigationManager _navi
@inject ISnackbar Snackbar
@inject CookieService _cookieService

<MudTextField @bind-Value="emails" Label="List of carriers" HelperText="Separate email by ';'" Variant="Variant.Outlined" /><br/>
<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InviteBiddersAsync" Disabled="@inviteBtnDisabled">Invite new carriers</MudButton><br/><br/> 
<p style="color: red;"><b>@errors</b></p>

@code {
    private CancellationTokenSource cts = new CancellationTokenSource();
    UserProvider? userDataProvider = null;
    bool inviteBtnDisabled = true;
    string emails {get; set;} = string.Empty; 
    string errors = string.Empty;
    UserEmailAndTimeOffset? userDataFromCookie = null;
    protected override async Task OnInitializedAsync()
    {
        userDataFromCookie = await _cookieService.GetUserEmailAndOffsetCookieAsync();

        if(userDataFromCookie is null)
        {
            _navi.NavigateTo("/");
            return;
        }

        userDataProvider = await _userService.SetUserProviderData(userDataFromCookie, cts.Token);
        if(userDataProvider is null)
            return; 

        if(userDataProvider.Roles.Contains(Role.User.Issuer))
            inviteBtnDisabled = false;
        else
            inviteBtnDisabled = true;
    }

    async Task InviteBiddersAsync()
    {
        string[] carriers = emails.Split(';', StringSplitOptions.RemoveEmptyEntries);
        if(carriers.Length > 0)
        {
            var inviteBiddersResult = await new InviteUsersCommand(carriers).ExecuteAsync(cts.Token);
            if(inviteBiddersResult.IsError)
                errors = $"Invite users error: {inviteBiddersResult.ErrorMsg}";
            else
                Snackbar.Add("All carriers was invited.", Severity.Success);
        }
        else
            errors = "List of new carriers is empty!";
            
    }
    public void Dispose()
    {
        if (cts is { IsCancellationRequested: false })
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException) { /* Ignoruj */ }
        }
        cts?.Dispose();
    }
}
