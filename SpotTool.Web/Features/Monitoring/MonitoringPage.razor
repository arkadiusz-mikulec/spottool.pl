@attribute [Route(UrlProvider.Monitoring.MonitoringPathWithIssuerIdAndItemId)]

@using FastEndpoints
@using MudBlazor
@using SpotTool.Web.Domain.Helpers
@using SpotTool.Web.Features.Shared.Cookies
@using SpotTool.Web.Features.Users
@inject IMonitoringHelper _monitoringHelper
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject UserService _userService
@inject CookieService _cookieService
@inject NavigationManager _navi
<h4>Monitoring module</h4>

<MudCard>
    <MudCardContent>
        @if(isDispo)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddMonitoringItems" StartIcon="@MudBlazor.Icons.Material.Filled.Add">
                Add new positions
            </MudButton>
            <br/><br/>
        }
        <MudGrid>
            <MudItem xs="12">
                @* <MudPaper Class="d-flex align-center justify-center mud-width-full py-8"> *@
                    <MudTable T="@MonitoringItem" Items="@data" Hover="true" Breakpoint="Breakpoint.Sm" Loading="false" LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh Style="@HideForCarrier()">Operations</MudTh>
                            <MudTh>Client</MudTh>
                            <MudTh>STATUS</MudTh>
                            <MudTh>Order_ID</MudTh>
                            <MudTh>Carrier</MudTh>
                            <MudTh>TruckNo</MudTh>
                            <MudTh>@(isDispo ? "PLT / PLT loaded" : "Units")</MudTh>
                            <MudTh>kg</MudTh>
                            <MudTh>LoadingTill</MudTh>
                            <MudTh>IsLoaded</MudTh>
                            <MudTh>IsUnloaded</MudTh>
                            <MudTh Style="@HideForCarrier()">Delete</MudTh>
                            <MudTh Style="@HideForDispo()">CarrierActions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Operations" Style="@HideForCarrier()">
                                @if(context.approved is null)
                                {
                                    <MudTooltip Text="GO!">
                                        <MudIconButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium" 
                                            OnClick="@(() => SetApproved(context, true))" Icon="@MudBlazor.Icons.Material.Filled.OilBarrel" />
                                    </MudTooltip>
                                    <MudTooltip Text="STOP!">
                                        <MudIconButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" 
                                            OnClick="@(() => SetApproved(context, false))" Icon="@MudBlazor.Icons.Material.Filled.OilBarrel" />
                                    </MudTooltip>
                                }
                                else if(context.approved == false)
                                {
                                    <MudTooltip Text="GO!">
                                        <MudIconButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium" 
                                            OnClick="@(() => SetApproved(context, true))" Icon="@MudBlazor.Icons.Material.Filled.OilBarrel" />
                                    </MudTooltip>
                                }
                                else if(!context.unloaded)
                                {
                                    <MudTooltip Text="STOP!">
                                        <MudIconButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" 
                                            OnClick="@(() => SetApproved(context, false))" Icon="@MudBlazor.Icons.Material.Filled.OilBarrel" />
                                    </MudTooltip>
                                }
                                @if(!string.IsNullOrEmpty(context.truckNo) && !context.unloaded && context.loaded)
                                {
                                    <MudTooltip Text="REQUEST GPS">
                                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" 
                                            OnClick="@(() => RequestGpsPosition(context))" Icon="@MudBlazor.Icons.Material.Filled.GpsOff" />
                                    </MudTooltip>
                                }
                            </MudTd>
                           
                            <MudTd DataLabel="Client">
                                @context.client
                            </MudTd>
                            <MudTd DataLabel="STATUS">
                                @if(context.approved is not null)
                                {
                                    string hour = string.Format("{0:HH:mm}", context.modifiedDateTime);
                                    if(context.approved == true)
                                    {
                                        <span style='color: green; font-weight: bold'>@context.reason.ToUpper() (ok - @hour)</span>
                                    }
                                    else
                                    {
                                        <span style='color: red; font-weight: bold'>@context.reason.ToUpper() (stop - @hour)</span>
                                    }
                                }
                            </MudTd>

                            <MudTd DataLabel="Order_ID">
                                <MudLink OnClick="(() => ShowHistory(context))">@context.transportOrder</MudLink>
                            </MudTd>
                            <MudTd DataLabel="Carrier">
                                @if(context.companies.Count > 1)
                                {
                                    <MudSelect @bind-Value="context.company"
                                        Placeholder="@string.Format("Select {0} company", context.carrier)">
                                        @foreach (var carrier in context.companies)
                                        {
                                            <MudSelectItem Value="carrier">@carrier</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    @context.company
                                }
                            </MudTd>
                            <MudTd DataLabel="TruckNo">
                                <MudTextField Value="context.truckNo" Label="Truck no" Variant="Variant.Outlined" 
                                    ValueChanged="@((string value) => OnTruckNoChanged(context, value))" Disabled="@context.loaded"/>
                                @* <MudTextField Value="context.truckNo" Label="Truck no" Variant="Variant.Outlined" 
                                    ValueChanged="@((string value) => OnTruckNoChanged(context.id, value))" Immediate="true"/> *@
                            </MudTd>
                            <MudTd DataLabel="PLT">
                                @if(isDispo)
                                {
                                    @string.Format("{0} / {1}", context.packages, context.packagesLoaded)
                                }
                                else
                                {
                                    <MudNumericField T="int" Value="context.packagesLoaded" Class="w-100" Min="0" 
                                        ValueChanged="@((int qty) => CheckLoadingUnitsQty(context, qty))" Disabled="@(context.approved == true)"/>
                                }
                            </MudTd>
                            <MudTd DataLabel="kg">
                                @if(isDispo)
                                {
                                    @string.Format("{0} / {1}", context.kg, context.kgLoaded)
                                }
                                else
                                {
                                    <MudNumericField T="float" Value="context.kgLoaded" Class="w-100" Min="0" 
                                        ValueChanged="@((float qty) => CheckLoadingKgQty(context, qty))" Disabled="@(context.approved == true)"/>
                                }
                            </MudTd>
                            <MudTd DataLabel="LoadingTill">
                                @string.Format("{0:MM/dd HH:mm}", context.loadingTill)
                            </MudTd>
                            <MudTd DataLabel="IsLoaded">
                                <MudTooltip Text="@(context.loadedDateTime is null ? "Not loaded yet" : context.loadedDateTime.ToString())">
                                    <MudCheckBox T="bool" Value="context.loaded" ReadOnly="@isDispo"
                                        ValueChanged="@(() => SetDateTime(context, DateKind.loading))" Disabled="@(context.approved == true)" />
                                </MudTooltip>
                            </MudTd>    
                            <MudTd DataLabel="IsUnloaded">
                                <MudTooltip Text="@(context.unloadedDateTime is null ? "In transit" : context.unloadedDateTime.ToString())">
                                    <MudCheckBox T="bool" Value="context.unloaded" ReadOnly="@isDispo"
                                        ValueChanged="@(() => SetDateTime(context, DateKind.delivery))" />
                                </MudTooltip>
                            </MudTd>   
                            <MudTd DataLabel="Delete" Style="@HideForCarrier()">
                                <MudTooltip Text="DELETE">
                                    <MudIconButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" 
                                        OnClick="@(() => DeleteItem(context))" Disabled="@(context.approved == true)"
                                        Icon="@MudBlazor.Icons.Material.Filled.Delete" />
                                </MudTooltip>
                            </MudTd>
                            <MudTd DataLabel="Report problem" Style="@HideForDispo()">
                                <MudTooltip Text="NO GOODS">
                                    <MudIconButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" 
                                        OnClick="@(() => NoGoods(context))" Disabled="@(context.approved == true)"
                                        Icon="@MudBlazor.Icons.Material.Filled.Delete" />
                                </MudTooltip>
                                <MudTooltip Text="TRAFFIC">
                                    <MudIconButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" 
                                        OnClick="@(() => OnProblemClick(context.id, $"Truck: {context.truckNo} is late", Severity.Info))" Disabled="@context.unloaded"
                                        Icon="@MudBlazor.Icons.Material.Filled.Delete" />
                                </MudTooltip>
                                <MudTooltip Text="ACCIDENT">
                                    <MudIconButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Medium" 
                                        OnClick="@(() => OnProblemClick(context.id, $"Truck: {context.truckNo} had accident", Severity.Error))" Disabled="@context.unloaded"
                                        Icon="@MudBlazor.Icons.Material.Filled.Delete" />
                                </MudTooltip>
                            </MudTd>
                        
                        </RowTemplate>
                    </MudTable>
                @* </MudPaper> *@
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public int? id {get; set;}
    [Parameter]
    public Guid? issuer {get; set;}
    UserProvider? userDataProvider = null;
    //string disp = "arkadiusz.mikulec@gmail.com";
    bool isDispo = false;
    List<MonitoringItem> data = [];
    UserEmailAndTimeOffset? currentUserFromCookie = null;
    //Dictionary<string, Type> columns { get; set; } = new();
    //Dictionary<string, string> usersLinks {get; set;} = new();
    CancellationTokenSource cts = new ();
    enum DateKind
    {
        loading,
        delivery,
        change
    }

    protected override async Task OnInitializedAsync()
    {
        await InitUserDataAsync();
        GetMonitoringData();
    }

    protected override async Task OnParametersSetAsync()
    {
        isDispo = userDataProvider!.Id.Equals(issuer);
        GetMonitoringData();
    }
    async Task InitUserDataAsync()
    {
        currentUserFromCookie = await _cookieService.GetUserEmailAndOffsetCookieAsync();

        if(currentUserFromCookie is null)
        {
            _navi.NavigateTo("/");    
            return;    
        }

        userDataProvider = await _userService.SetUserProviderData(currentUserFromCookie, cts.Token);
        isDispo = userDataProvider!.Id.Equals(issuer);
    }
    private string HideForDispo()
    {
        return isDispo ? "display: none" : "";
    }
    private string HideForCarrier()
    {
        return !isDispo ? "display: none" : "";
    }
    private void OnProblemClick(int id, string info, MudBlazor.Severity severity)
    {
        Snackbar.Add(info, severity);
        _monitoringHelper.AddHistoryItem(id, new HistoryItem{
            //id = Random.Shared.Next(100, 1000),
            insertDate = DateTime.Now,
            info = info,
            _event = "PROBLEM"
         });
        
    }
    private void OnTruckNoChanged(MonitoringItem position, string value)
    {
        Console.WriteLine($"New truck no: {value}");
        position.truckNo = value;
        _monitoringHelper.AddHistoryItem(position.id, new HistoryItem{
            //id = Random.Shared.Next(100, 1000),
            insertDate = DateTime.Now,
            info = $"Truck no was set to: {value} for OrderId: {position.transportOrder}",
            _event = "SET"
        });
    }
    Task ShowHistory(MonitoringItem position)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium };
        var parameters = new DialogParameters<MonitoringHistoryDialog>();

        parameters.Add(x => x.UserOffset, TimeSpan.FromHours(1));
        parameters.Add(x=>x.History, position.history);

        return DialogService.ShowAsync<MonitoringHistoryDialog>($"Protocol for ORDER_ID: {position.transportOrder}", parameters, options);
    }
    Task RequestGpsPosition(MonitoringItem position)
    {
        _monitoringHelper.AddHistoryItem(position.id, new HistoryItem{
            //id = Random.Shared.Next(100, 1000),
            insertDate = DateTime.Now,
            info = "GPS send request",
            _event = "GPS"
         });
        
        _monitoringHelper.AddHistoryItem(position.id, new HistoryItem{
            //id = Random.Shared.Next(100, 1000),
            insertDate = DateTime.Now,
            info = $"Truck: {position.truckNo} position:59.3455,19.05666)",
            _event = "GPS"
         });
        Snackbar.Add($"GPS position for truck: {position.truckNo.ToUpper()} are: (59.3455, 19.05666)", Severity.Info);
        
        //data = _monitoringHelper.GetMonitoring(userEmail);
        return Task.CompletedTask;
    }
    Task NoGoods(MonitoringItem position)
    {
        position.packagesLoaded = 0;
        position.kgLoaded = 0;
        position.approved = false;
        position.modifiedDateTime = DateTime.Now;
        position.reason = "no goods";
        @* position.loaded = true;
        position.loadedDateTime = position.modifiedDateTime;*@ 
         

        return Task.CompletedTask;
    }
    Task SetDateTime(MonitoringItem position, DateKind kind)
    {
        Console.WriteLine($"Triger set date time: {kind}");
        switch(kind)
        {
            case DateKind.loading:
            {
                position.loadedDateTime = DateTime.Now;
                position.loaded = true;
                CheckLoadingKgQty(position, position.kgLoaded);
                CheckLoadingUnitsQty(position, position.packagesLoaded);
                break;
            }
            case DateKind.delivery:
            {
                position.unloadedDateTime = DateTime.Now;
                position.unloaded = true;
                GetMonitoringData();   
                break;
            } 
            default:
            {
                position.modifiedDateTime = DateTime.Now;
                break;
            }
        }
        
        return Task.CompletedTask;
    }
    Task SetApproved(MonitoringItem position, bool value)
    {
        position.approved = value;
        position.modifiedDateTime = DateTime.Now;
        @* if(value)
            position.reason = string.Empty; *@

        return Task.CompletedTask;
    }

    Task CheckLoadingUnitsQty(MonitoringItem position, int qty)
    {
        Console.WriteLine("CheckLoadingQty triggered!");
        if(position.packages != qty)
        {
            position.approved = false;
            position.reason = "wrong qty";
        }
        else
        {
            position.approved = true;
            //position.reason = string.Empty;
        }
        position.packagesLoaded = qty;
        position.loaded = true;
        position.loadedDateTime = DateTime.Now;

        position.modifiedDateTime = DateTime.Now;
        _monitoringHelper.AddHistoryItem(position.id, new HistoryItem{
            //id = Random.Shared.Next(100, 200),
            info = "Material qty change",
            insertDate = DateTime.Now,
            _event = "MATERIAL"
        });

        return Task.CompletedTask;
    }
    Task CheckLoadingKgQty(MonitoringItem position, float qty)
    {
        Console.WriteLine("CheckLoadingQty triggered!");
        if(position.kg != qty)
        {
            position.approved = false;
            position.reason = "wrong qty";
        }
        else
        {
            position.approved = true;
            //position.reason = string.Empty;
        }
        position.kgLoaded = qty;
        position.loaded = true;
        position.loadedDateTime = DateTime.Now;

        position.modifiedDateTime = DateTime.Now;
        _monitoringHelper.AddHistoryItem(position.id, new HistoryItem{
            //id = Random.Shared.Next(100, 200),
            info = "Material qty change",
            insertDate = DateTime.Now,
            _event = "MATERIAL"
        });

        return Task.CompletedTask;
    }
    Task DeleteItem(MonitoringItem position)
    {
        string _not = string.Empty;
        string info = $"Position for transport order: {position.transportOrder} was{_not} deleted.";
        if(!_monitoringHelper.RemoveItem(position))
        {
            _not = " not";
            Snackbar.Add(info, Severity.Error);
        }
        else
        {
            Snackbar.Add(info, Severity.Success);
            GetMonitoringData();
        }
        return Task.CompletedTask;
    }

    async Task AddMonitoringItems()
    {
        var bidders = await _userService.GetAllBiddersAsync(cts.Token);
        foreach(var bidder in bidders.Where(m=>!m.Equals(userDataProvider!.Email, StringComparison.CurrentCultureIgnoreCase)))
        {
            var addMonitoringItemCommand = await new AddMonitoringItemCommand(
                $"Spot-{Random.Shared.Next(1000, 9999)}", 
                userDataProvider!.Email, 
                bidder,
                1)
            .ExecuteAsync(cts.Token);

            if(addMonitoringItemCommand.IsError)
                Snackbar.Add(addMonitoringItemCommand.ErrorMesage!, Severity.Error);
        }
        GetMonitoringData();
    }
    void GetMonitoringData()
    {
        data = _monitoringHelper.GetMonitoring(isDispo, userDataProvider!.Email, id);
        //StateHasChanged();
    }
    
}
