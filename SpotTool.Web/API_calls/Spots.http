@host = http://localhost:5017
@spotId = 01a17cce-3160-74f1-9841-592963b4071a

### Spot create from TMS
POST {{host}}/api/v1/integrations/spots
Content-Type: application/json

{
    "UserEmail": "arkadiusz.mikulec@gmail.com",
    "Route": "DE43->PL01",
    "Price": 700
}

### Get Spot
GET {{host}}/api/v1/integrations/spots/{{spotId}}

###Spot approval
PATCH {{host}}/api/v1/integrations/spots/{{spotId}}/approve

###Spot Cancelation
PATCH {{host}}/api/v1/integrations/spots/{{spotId}}/cancel
Content-Type: application/json

{
    "Reason": "Bo tak chciałem"
}

### Update spot deadlina
PATCH {{host}}/api/v1/integrations/spots/{{spotId}}/update-deadlina
Content-Type: application/json

{
    "SpotDeadline": "2026-10-23T11:54:12+02:00"
}

### Add Offer by biuro
POST {{host}}/api/v1/integrations/offers
Content-Type: application/json

{
    "SpotId": "{{spotId}}",
    "CreateByUserId": "01a16423-1b77-74a2-ba9c-e8a68d2ab280",
    "CreateForUserId": "01a16423-1b77-74a2-ba9c-e8a68d2ab280",
    "Value": 50
}

### Add offer by amikulec
POST {{host}}/api/v1/integrations/offers
Content-Type: application/json

{
    "SpotId": "{{spotId}}",
    "CreateByUserId": "01a14858-e303-71a2-88c0-87307c2ebec2",
    "CreateForUserId": "01a14858-e303-71a2-88c0-87307c2ebec2",
    "Value": 85
}

### Add negotiarion offer by arkadiusz.mikulec for amikulec
POST {{host}}/api/v1/integrations/offers
Content-Type: application/json

{
    "SpotId": "{{spotId}}",
    "CreateByUserId": "01a14858-e2fd-7c97-99e0-1150990a29d3",
    "CreateForUserId": "01a14858-e303-71a2-88c0-87307c2ebec2",
    "Value": 850,
    "ValidTill": "2026-10-19T15:15:12+02:00"
}

### Add negotiarion offer by arkadiusz.mikulec for biuro
POST {{host}}/api/v1/integrations/offers
Content-Type: application/json 

{
    "SpotId": "{{spotId}}",
    "CreateByUserId": "01a14858-e2fd-7c97-99e0-1150990a29d3",
    "CreateForUserId": "01a14858-e303-73fb-83d3-0ca37816ce81",
