@host = http://localhost:5017

@spotId = 01a123f9-e4fc-7570-9025-120cd65168ae
### Spot create from TMS
POST {{host}}/api/v1/integrations/spots
Content-Type: application/json

#Request(string UserEmail, string Route, decimal Price, Status.Spot? Status, DbModels.ContactPersonDetail? ContactPerson);
{
    "UserEmail": "arkadiusz.mikulec@gmail.com",
    "Route": "DE43->PL01",
    "Price": 700
}

### Get Spot
GET {{host}}/api/v1/integrations/spots/{{spotId}}

###Spot approval
POST {{host}}/api/v1/integrations/spot/{{spotId}}/approve

### Update spot deadlina
PATCH  {{host}}/api/v1/integrations/spot/update-deadlina
Content-Type: application/json

{
    "SpotId": "{{spotId}}",
    "SpotDeadline": "2026-10-09T16:55:12+02:00"
}

### Add Offer
POST {{host}}/api/v1/integrations/offers
Content-Type: application/json

{
    "SpotId": "{{spotId}}",
    "CreateByUserId": "01a12095-3ffa-780f-8c31-2aa01f153872",
    "CreateForUserId": "01a12095-3ffa-780f-8c31-2aa01f153872",
    "Value": 600
}

### Add offer from amikulec
POST {{host}}/api/v1/integrations/offers
Content-Type: application/json

{
    "SpotId": "{{spotId}}",
    "CreateByUserId": "01a12095-3ffa-7fdf-a0a0-37e7545f1c05",
    "CreateForUserId": "01a12095-3ffa-7fdf-a0a0-37e7545f1c05",
    "Value": 300
}


