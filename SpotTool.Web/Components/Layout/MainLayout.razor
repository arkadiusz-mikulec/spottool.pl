@using SpotTool.Web.Domain.Types
@using SpotTool.Web.Features.Shared.Cookies
@using SpotTool.Web.Features.Users
@inherits LayoutComponentBase

@inject CookieService _cookieService
@inject UserService _userService;

<MudThemeProvider @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">Spottool</MudText>
        <MudSpacer />
        <MudMenu EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="@_menuLabel" Color="Color.Inherit">
            <MudMenuItem Label="Change mode" OnClick="ChangeMode" Icon="@MudBlazor.Icons.Material.Filled.Settings"/>
            @if(!isLogged)
            {
                <MudMenuItem Label="Login" Href="/" Icon="@MudBlazor.Icons.Material.Filled.Login"/>    
            }
            else
            {
                <MudMenuItem Label="Logout" Href="/logout" Icon="@MudBlazor.Icons.Material.Filled.Logout"/>
            }
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="10">
        <NavMenu UserId="@_userId" IsIssuerAndBidder="@isIssuerAndBidder" />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
    @* <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div> *@
</MudLayout>

@code {
    // prev incon: MoreVert
    bool _drawerOpen = true;
    bool _darkMode = true;
    string _menuLabel = "Open menu";
    bool isLogged = false;
    Guid? _userId = null;
    bool isIssuerAndBidder = true;
    void ChangeMode()
    {
        _darkMode = !_darkMode;
    }
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("OnInitializedAsync() - main layout");
        //W sytuacji wyłączenia prerenderingu HttpContext staje sie nie potrzebny!!!
        //var userData = await _cookieService.GetUserEmailAndOffsetCookieFromHttpContextAsync();
        
        var userData = await _cookieService.GetUserEmailAndOffsetCookieAsync();
        
        if(userData is not null)
        {
            Console.WriteLine("Cookie user is set!!!");
            _menuLabel = userData.Email;
            var userProviderData = await _userService.SetUserProviderData(userData, CancellationToken.None);
            if(userProviderData is not null)
            {
                _userId = userProviderData.Id;
                isIssuerAndBidder = userProviderData.Roles.Count > 1 && !userProviderData.Roles.Contains(Role.User.Admin);
            }
            isLogged = true;
        }
    }
}