@using SpotTool.Web.Domain.Helpers

@inject NavigationManager _navigation

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@MudBlazor.Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="spots/active" Match="NavLinkMatch.Prefix" Icon="@MudBlazor.Icons.Material.Filled.List">Active spots</MudNavLink>
    <MudNavLink Href="users/invite"  Match="NavLinkMatch.Prefix" Icon="@MudBlazor.Icons.Material.Filled.Add">Invite carrier</MudNavLink>
    <MudNavGroup Title="@UrlProvider.Monitoring.LinkAndIcon.Value.Text" Icon="@UrlProvider.Monitoring.LinkAndIcon.Value.Icon" Expanded="true">
        <MudNavLink OnClick="@(() => OnMonitoringClick(UserId))" Match="NavLinkMatch.Prefix">My positions</MudNavLink>
        <MudNavLink OnClick="@(() => OnMonitoringClick(null))" Match="NavLinkMatch.All">Others</MudNavLink>
    </MudNavGroup>
    
    @* Nie działa !!!<MudNavGroup Title="@UrlProvider.Monitoring.LinkAndIcon.Value.Text" Icon="@UrlProvider.Monitoring.LinkAndIcon.Value.Icon" Expanded="true">
        <MudNavLink Href="@($"{UrlProvider.Monitoring.MonitoringPath}/{UserId}")" OnClick="@(() => OnMonitoringClick(UserId))"
             Match="NavLinkMatch.Prefix">My positions</MudNavLink>
        <MudNavLink Href="@UrlProvider.Monitoring.MonitoringPath" OnClick="@(() => OnMonitoringClick(null))" 
            Match="NavLinkMatch.Prefix">Others</MudNavLink>
</MudNavGroup> *@
    <MudNavLink Href="logout"  Match="NavLinkMatch.Prefix" Icon="@MudBlazor.Icons.Material.Filled.Logout">Logout</MudNavLink>
</MudNavMenu>

@code{
    [Parameter]
    public Guid? UserId {get; set;}
    [Parameter]
    public bool IsIssuerAndBidder {get; set;} = true;

    void OnMonitoringClick(Guid? userId)
    {
        _navigation.NavigateTo($"{UrlProvider.Monitoring.MonitoringPath}/{userId}", true);
    }
}

