@page "/"
@using SpotTool.Web.Features.Shared.Cookies
@using SpotTool.Web.Features.Users

@inject CookieService _cookieService
@inject NavigationManager _navigation
@inject UserService _userService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Home</PageTitle>

<h3>Log in please</h3>

<MudTextField @bind-Value="login" Label="Provide email address" Variant="Variant.Outlined" /><br/>
<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Login" StartIcon="@MudBlazor.Icons.Material.Filled.Login">Log in</MudButton> 

@code {
    private string login {get; set;} = string.Empty;
    CancellationTokenSource cts = new ();
    
    async Task Login()
    {
        if(string.IsNullOrEmpty(login.Trim()))
            Snackbar.Add("Provide email address to login", Severity.Error);
        else
        {
            var user = await _userService.GetUserByEmailAsync(login, cts.Token);
            if(user is null)
                Snackbar.Add($"User: {login} does not exist", Severity.Error);
            else
            {
                await _cookieService.SetUserEmailAndOffsetCookieAsync(login, 7);
                _navigation.NavigateTo("spots/active", true);    
            }
        }
    }

    public void Dispose()
    {
        // Odpinamy subskrypcję stanu, aby zapobiec wyciekom pamięci
        //_subscription.Dispose();

        if (cts is { IsCancellationRequested: false })
        {
            try
            {
                cts.Cancel();
            }
            catch (ObjectDisposedException) { /* Ignoruj */ }
        }
        cts?.Dispose();
    }
}